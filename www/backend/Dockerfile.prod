# MyNotes Backend - Production Image
# Wird per GitHub Actions nach ghcr.io gepusht und in Plesk-Docker geladen.

FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /app

# System-Bibliotheken (libmagic fuer python-magic, curl fuer Healthcheck).
RUN apt-get update \
    && apt-get install -y --no-install-recommends libmagic1 curl \
    && rm -rf /var/lib/apt/lists/*

# Dependencies separat fuer besseres Layer-Caching.
COPY pyproject.toml ./
RUN pip install --upgrade pip \
    && pip install "."

# Build-Version (Git-SHA), wird per CI uebergeben.
ARG BUILD_SHA=dev
ENV APP_VERSION=$BUILD_SHA

# Anwendungscode + Migrationen.
COPY app ./app
COPY alembic ./alembic
COPY alembic.ini ./alembic.ini

# Laufzeit-Verzeichnisse.
RUN mkdir -p /app/data/assets

EXPOSE 8000

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD curl -fsS http://localhost:8000/healthz || exit 1

# Beim Start: Migrationen ausfuehren, dann Server.
CMD ["sh", "-c", "alembic upgrade head && exec uvicorn app.main:app --host 0.0.0.0 --port 8000 --workers 1 --proxy-headers"]
