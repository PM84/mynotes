# =============================================================================
# MyNotes Backend - Beispiel-Konfiguration
# -----------------------------------------------------------------------------
# Diese Datei in ".env" kopieren und Werte anpassen:
#   cp .env.example .env
# Niemals echte Secrets/Passwoerter in dieses Beispiel eintragen!
#
# Hinweise:
# - Keine Anfuehrungszeichen verwenden, ausser der Wert enthaelt Sonderzeichen.
# - Keine Inline-Kommentare hinter Werten (z.B. "KEY=val # kommentar"); manche
#   dotenv-Parser interpretieren das als Teil des Werts.
# - Sonderzeichen im DB-Passwort URL-encoden (@ = %40, : = %3A, / = %2F, ...).
# =============================================================================

# --- Allgemein ---------------------------------------------------------------
APP_NAME=MyNotes
DEBUG=false

# --- Datenbank ---------------------------------------------------------------
# Format: mysql+asyncmy://USER:URLENCODED_PASSWORD@HOST:PORT/DBNAME
DB_URL=mysql+asyncmy://mynotes:CHANGE_ME@127.0.0.1:3306/mynotes

# --- Authentifizierung -------------------------------------------------------
# JWT_SECRET zwingend ersetzen. Erzeugen z.B. mit:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=CHANGE_ME_GENERATE_A_LONG_RANDOM_STRING
JWT_ALG=HS256
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7

# --- Asset-Speicher ----------------------------------------------------------
# Verzeichnis muss existieren und vom Backend-Prozess beschreibbar sein.
ASSET_DIR=/var/www/mynotes/data/assets
UPLOAD_MAX_MB=64

# --- Bootstrap-Admin (wird beim ersten Start angelegt) -----------------------
# Nach dem ersten Login sofort ueber das Admin-UI Passwort aendern!
BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME

# --- CORS --------------------------------------------------------------------
# Kommagetrennte Liste der erlaubten Frontend-Origins (ohne Slash am Ende).
CORS_ORIGINS=https://notes.example.com
